   "source": [
    "def fit_ridge(X, t, lamb):\n",
    "    # Your code here\n",
    "    XTX = np.matmul(X.transpose, X)\n",
    "    NLambI = len(X) * lamb * np.identity(len(X))\n",
    "    inverted = np.linalg.inv(XTX + NLambI)\n",
    "    return np.matmul(np.matmul(inverted, X.transpose), t)"
   ]
